---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="WanderQuest - Billetera" activeTab="rewards">
  <div class="min-h-screen pb-24">
    <!-- Header -->
    <header class="px-6 pt-12 pb-4 flex justify-between items-center sticky top-0 z-10 bg-background-light/80 backdrop-blur-md">
      <div>
        <h1 class="text-2xl font-bold text-neutral-900">Mi Billetera</h1>
        <p class="text-sm text-neutral-500 font-medium">WanderQuest</p>
      </div>
      <button class="p-2 rounded-full bg-white shadow-sm border border-neutral-100 text-neutral-600 hover:bg-neutral-50 transition-colors">
        <span class="material-icons-round">notifications_none</span>
      </button>
    </header>

    <!-- Main Content -->
    <main class="px-6 space-y-8">
      <!-- Balance Card -->
      <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary to-primary-dark shadow-soft text-white p-6">
        <!-- Abstract Pattern Background -->
        <div class="absolute top-0 right-0 -mr-8 -mt-8 w-48 h-48 rounded-full bg-white/10 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 -ml-8 -mb-8 w-32 h-32 rounded-full bg-black/10 blur-2xl"></div>

        <div class="relative z-10">
          <div class="flex justify-between items-start mb-6">
            <div class="bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full border border-white/10 flex items-center space-x-2">
              <span class="material-icons-round text-sm">account_balance_wallet</span>
              <span class="text-xs font-semibold tracking-wide">STELLAR NETWORK</span>
            </div>
            <span class="material-icons-round opacity-80">qr_code_scanner</span>
          </div>

          <div class="space-y-1 mb-4">
            <h2 class="text-5xl font-bold tracking-tight">250 <span class="text-2xl font-medium opacity-80">WQ</span></h2>
            <p class="text-lg opacity-80 font-medium">≈ $25.000 CLP <span class="text-sm">(1 WQ = $100 CLP)</span></p>
          </div>

          <p class="text-xs text-white/70 mb-4">Canjeable en todos los comercios aliados</p>

          <!-- Withdraw Button -->
          <button class="w-full bg-white/20 hover:bg-white/30 backdrop-blur-sm text-white font-bold py-3 rounded-xl transition-colors flex items-center justify-center gap-2 border border-white/10 mb-4">
            <span class="material-icons-round text-sm">account_balance</span>
            <span>Retirar a dinero real</span>
            <span class="text-xs opacity-70">(fee 20%)</span>
          </button>

          <div class="flex items-center justify-between bg-black/20 rounded-lg p-3 backdrop-blur-md border border-white/5">
            <div class="flex items-center space-x-2 overflow-hidden">
              <span class="material-icons-round text-sm opacity-70">link</span>
              <span class="font-mono text-sm opacity-90 truncate">GDA...7X2</span>
            </div>
            <button class="text-xs font-bold bg-white/10 hover:bg-white/20 transition-colors px-3 py-1.5 rounded-full">
              COPIAR
            </button>
          </div>
        </div>
      </section>


      <!-- Map Section -->
      <section>
        <div class="flex justify-between items-end mb-4">
          <div>
            <h3 class="text-lg font-bold text-neutral-900">Donde canjear</h3>
            <p class="text-sm text-neutral-500">Socios cercanos a ti</p>
          </div>
          <button class="text-primary text-sm font-bold flex items-center hover:opacity-80">
            Ver mapa <span class="material-icons-round text-sm ml-1">arrow_forward</span>
          </button>
        </div>

        <div class="relative h-48 rounded-xl overflow-hidden shadow-card group cursor-pointer bg-gradient-to-br from-neutral-200 to-neutral-300">
          <!-- Map placeholder -->
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="material-icons-round text-neutral-400 text-6xl">map</span>
          </div>

          <!-- Floating Pins -->
          <div class="absolute top-1/3 left-1/4 transform -translate-x-1/2 -translate-y-1/2">
            <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center shadow-lg border-2 border-white animate-bounce">
              <span class="material-icons-round text-white text-xs">local_cafe</span>
            </div>
          </div>
          <div class="absolute bottom-1/3 right-1/3 transform -translate-x-1/2 -translate-y-1/2">
            <div class="w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-lg text-primary">
              <span class="material-icons-round text-xs">restaurant</span>
            </div>
          </div>

          <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm flex items-center gap-1">
            <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
            3 socios a &lt; 500m
          </div>
        </div>
      </section>

      <!-- Partners Carousel -->
      <section>
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-bold text-neutral-900">Ofertas destacadas</h3>
        </div>

        <div class="flex gap-4 overflow-x-auto pb-4 hide-scrollbar -mx-6 px-6">
          <!-- Partner Card 1 -->
          <div class="flex-none w-64 bg-white rounded-xl p-4 shadow-card border border-neutral-100 relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-primary text-white text-xs font-bold px-3 py-1 rounded-bl-xl rounded-tr-xl z-10">
              -10%
            </div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center border-2 border-neutral-100">
                <span class="material-icons-round text-amber-600">local_cafe</span>
              </div>
              <div>
                <h4 class="font-bold text-neutral-900 leading-tight">Cafe Altura</h4>
                <p class="text-xs text-neutral-500">Cafeteria de especialidad</p>
              </div>
            </div>
            <div class="flex justify-between items-center mt-2">
              <span class="text-sm font-medium text-neutral-600">Todo el menu</span>
              <button class="bg-primary/10 hover:bg-primary text-primary hover:text-white px-3 py-1.5 rounded-full text-xs font-bold transition-all">
                20 WQ
              </button>
            </div>
          </div>

          <!-- Partner Card 2 -->
          <div class="flex-none w-64 bg-white rounded-xl p-4 shadow-card border border-neutral-100 relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-coral text-white text-xs font-bold px-3 py-1 rounded-bl-xl rounded-tr-xl z-10">
              2x1
            </div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center border-2 border-neutral-100">
                <span class="material-icons-round text-red-600">restaurant</span>
              </div>
              <div>
                <h4 class="font-bold text-neutral-900 leading-tight">La Mechada</h4>
                <p class="text-xs text-neutral-500">Sandwicheria</p>
              </div>
            </div>
            <div class="flex justify-between items-center mt-2">
              <span class="text-sm font-medium text-neutral-600">Sandwich clasico</span>
              <button class="bg-primary/10 hover:bg-primary text-primary hover:text-white px-3 py-1.5 rounded-full text-xs font-bold transition-all">
                45 WQ
              </button>
            </div>
          </div>

          <!-- Partner Card 3 -->
          <div class="flex-none w-64 bg-white rounded-xl p-4 shadow-card border border-neutral-100 relative overflow-hidden">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-12 h-12 rounded-full bg-neutral-100 flex items-center justify-center">
                <span class="material-icons-round text-neutral-400">storefront</span>
              </div>
              <div>
                <h4 class="font-bold text-neutral-900 leading-tight">Ver mas</h4>
                <p class="text-xs text-neutral-500">Explora el catalogo</p>
              </div>
            </div>
            <div class="flex justify-between items-center mt-2">
              <span class="text-sm font-medium text-neutral-600">15+ Socios</span>
              <button class="bg-neutral-100 px-3 py-1.5 rounded-full text-xs font-bold hover:bg-neutral-200 transition-colors">
                <span class="material-icons-round text-sm">arrow_forward</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- Transaction History -->
      <section>
        <h3 class="text-lg font-bold text-neutral-900 mb-4">Historial reciente</h3>
        <div class="space-y-3">
          <!-- Item 1: Earning -->
          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/50 transition-colors">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600">
                <span class="material-icons-round text-xl">emoji_events</span>
              </div>
              <div>
                <h4 class="font-bold text-neutral-900 text-sm">Lugar Secreto</h4>
                <p class="text-xs text-neutral-500">Plaza de Armas · Hoy, 10:30 AM</p>
              </div>
            </div>
            <span class="font-bold text-green-600 text-sm">+50 WQ</span>
          </div>

          <!-- Item 2: Redemption -->
          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/50 transition-colors">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center text-red-600">
                <span class="material-icons-round text-xl">local_offer</span>
              </div>
              <div>
                <h4 class="font-bold text-neutral-900 text-sm">Canjeado @ Cafe Altura</h4>
                <p class="text-xs text-neutral-500">Promo 10% · Ayer, 4:15 PM</p>
              </div>
            </div>
            <span class="font-bold text-neutral-900 text-sm">-20 WQ</span>
          </div>

          <!-- Item 3: Earning -->
          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/50 transition-colors">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600">
                <span class="material-icons-round text-xl">explore</span>
              </div>
              <div>
                <h4 class="font-bold text-neutral-900 text-sm">Recompensa de Exploracion</h4>
                <p class="text-xs text-neutral-500">Barrio Lastarria · 22 Ago</p>
              </div>
            </div>
            <span class="font-bold text-green-600 text-sm">+25 WQ</span>
          </div>
        </div>

        <button class="w-full mt-4 py-2 text-center text-sm font-bold text-primary hover:underline">
          Ver todo el historial
        </button>
      </section>
    </main>
  </div>
</AppLayout>
