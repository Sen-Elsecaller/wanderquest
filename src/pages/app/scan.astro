---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="WanderQuest - Escanear" showBottomNav={false}>
  <div class="relative w-full min-h-screen bg-black overflow-hidden">
    <!-- Camera Viewfinder Background -->
    <div class="absolute inset-0 z-0">
      <div class="w-full h-full bg-gradient-to-br from-neutral-700 to-neutral-900 flex items-center justify-center">
        <!-- Simulated camera view -->
        <div class="absolute inset-0 opacity-30">
          <div class="absolute top-1/4 left-1/3 w-32 h-48 bg-neutral-600/50 rounded-lg transform rotate-3"></div>
          <div class="absolute bottom-1/3 right-1/4 w-24 h-32 bg-neutral-500/30 rounded-lg transform -rotate-6"></div>
        </div>
      </div>
      <div class="absolute inset-0 bg-black/10 pointer-events-none"></div>
    </div>

    <!-- Top Bar -->
    <div class="absolute top-0 left-0 right-0 z-20 pt-12 pb-6 px-6 flex justify-between items-start bg-gradient-to-b from-black/60 to-transparent">
      <a href="/app/quest" class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white hover:bg-white/30 transition">
        <span class="material-icons-round">arrow_back</span>
      </a>
      <div class="flex flex-col items-end">
        <div class="bg-primary/90 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg backdrop-blur-sm mb-2">
          Nivel 12
        </div>
        <button class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white hover:bg-white/30 transition">
          <span class="material-icons-round">settings</span>
        </button>
      </div>
    </div>

    <!-- AR Floating Indicator -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10 animate-bounce" style="animation-duration: 2s;">
      <div class="glass-panel text-neutral-800 px-5 py-3 rounded-full shadow-xl flex items-center space-x-3 border border-white/50">
        <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-white shadow-md">
          <span class="material-icons-round text-sm transform -rotate-45">navigation</span>
        </div>
        <div class="flex flex-col leading-tight">
          <span class="font-bold text-sm">Monumento Central</span>
          <span class="text-xs text-primary font-bold">A 50 metros</span>
        </div>
      </div>
      <div class="w-0 h-0 border-l-[8px] border-l-transparent border-r-[8px] border-r-transparent border-t-[10px] border-t-white/95 mx-auto mt-[-1px]"></div>
    </div>

    <!-- Central Scanner Reticle -->
    <div class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none">
      <div class="relative w-64 h-64 border-2 border-white/30 rounded-3xl">
        <!-- Corners -->
        <div class="absolute top-0 left-0 w-8 h-8 border-t-4 border-l-4 border-primary rounded-tl-xl -mt-1 -ml-1"></div>
        <div class="absolute top-0 right-0 w-8 h-8 border-t-4 border-r-4 border-primary rounded-tr-xl -mt-1 -mr-1"></div>
        <div class="absolute bottom-0 left-0 w-8 h-8 border-b-4 border-l-4 border-primary rounded-bl-xl -mb-1 -ml-1"></div>
        <div class="absolute bottom-0 right-0 w-8 h-8 border-b-4 border-r-4 border-primary rounded-br-xl -mb-1 -mr-1"></div>

        <!-- Scanning Animation Line -->
        <div class="absolute left-2 right-2 h-1 bg-primary/50 shadow-[0_0_15px_rgba(8,145,178,0.8)] scan-line rounded-full"></div>

        <!-- Helper Text -->
        <div class="absolute -bottom-12 left-0 right-0 text-center">
          <span class="text-white/90 text-sm font-medium bg-black/40 px-3 py-1 rounded-lg backdrop-blur-sm">
            Alinea el codigo QR
          </span>
        </div>
      </div>
    </div>

    <!-- Bottom Panel (Objective) -->
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <div class="glass-panel rounded-t-3xl p-8 pb-10 shadow-[0_-10px_40px_rgba(0,0,0,0.2)]">
        <div class="w-12 h-1.5 bg-neutral-200 rounded-full mx-auto mb-6"></div>
        <div class="flex items-start justify-between mb-4">
          <div>
            <h2 class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Objetivo Actual</h2>
            <p class="text-neutral-800 text-lg font-bold leading-snug pr-4">
              Encuentra el codigo QR en la base del monumento
            </p>
          </div>
          <button class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors">
            <span class="material-icons-round">lightbulb</span>
          </button>
        </div>
        <div class="flex items-center space-x-2 text-xs text-neutral-500 font-medium mt-2">
          <span class="material-icons-round text-base text-neutral-400">info</span>
          <span>Busca cerca de la placa conmemorativa del lado norte.</span>
        </div>
      </div>
    </div>

    <!-- SUCCESS STATE OVERLAY -->
    <div id="success-overlay" class="absolute inset-0 z-50 flex flex-col items-center justify-end pb-8 bg-black/40 backdrop-blur-md">
      <!-- Success Card -->
      <div class="w-full px-4 mb-4">
        <div class="bg-white rounded-3xl p-6 shadow-2xl">
          <!-- Icon & Burst -->
          <div class="relative flex justify-center mb-6 mt-2">
            <div class="absolute inset-0 bg-primary/20 blur-xl rounded-full scale-150 animate-pulse"></div>
            <div class="relative w-24 h-24 bg-gradient-to-tr from-primary to-cyan-400 rounded-full flex items-center justify-center shadow-lg ring-4 ring-white">
              <span class="material-icons-round text-white text-5xl">check_circle</span>
            </div>
          </div>

          <!-- Text Content -->
          <div class="text-center space-y-2 mb-8">
            <h2 class="text-2xl font-extrabold text-neutral-900">
              ¡Quest completada!
            </h2>

            <!-- Reward -->
            <div class="py-2">
              <div class="inline-flex items-center justify-center space-x-2 bg-primary/10 px-6 py-2 rounded-full border border-primary/20">
                <span class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-[10px] text-white font-bold">W</span>
                <span class="text-xl font-bold text-primary">+50 WQ</span>
              </div>
              <p class="text-xs text-neutral-500 mt-2">Añadidos a tu billetera · Canjéalos en cualquier comercio aliado</p>
            </div>

            <!-- Achievement -->
            <div class="flex items-center justify-center space-x-2 text-sm text-neutral-500 pt-2">
              <span class="material-icons-round text-gold">emoji_events</span>
              <span>Logro desbloqueado: <span class="font-bold text-neutral-800">Explorador Urbano</span></span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-3">
            <a href="/app" class="w-full bg-primary hover:bg-primary-dark text-white font-bold text-lg py-4 rounded-full shadow-lg shadow-primary/30 transition-all active:scale-95 flex items-center justify-center space-x-2">
              <span>Siguiente quest</span>
              <span class="material-icons-round">arrow_forward</span>
            </a>
            <a href="/app/wallet" class="block w-full bg-transparent hover:bg-neutral-50 text-neutral-600 font-bold text-base py-3 rounded-full transition-colors text-center">
              Ver recompensa
            </a>
          </div>
        </div>
      </div>

      <!-- Confetti dots -->
      <div class="absolute top-20 left-10 w-3 h-3 bg-gold rounded-full animate-bounce" style="animation-delay: 75ms;"></div>
      <div class="absolute top-40 right-12 w-4 h-4 bg-primary rounded-full animate-bounce" style="animation-delay: 150ms;"></div>
      <div class="absolute top-24 right-1/3 w-2 h-2 bg-coral rounded-full animate-bounce"></div>
    </div>
  </div>

  <script is:inline>
    // Toggle success overlay on click (for demo purposes)
    document.addEventListener('DOMContentLoaded', () => {
      const overlay = document.getElementById('success-overlay');
      const scanner = document.querySelector('.scan-line');

      // Click anywhere on scanner area to toggle success
      document.addEventListener('click', (e) => {
        if (e.target.closest('#success-overlay a')) return; // Don't toggle when clicking links
        if (e.target.closest('a')) return; // Don't toggle when clicking any link
        if (e.target.closest('button')) return; // Don't toggle when clicking buttons

        if (overlay) {
          overlay.classList.toggle('hidden');
        }
      });
    });
  </script>
</AppLayout>
