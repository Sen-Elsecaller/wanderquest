---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="WanderQuest - Perfil" activeTab="profile">
  <div class="min-h-screen pb-24">
    <!-- Header -->
    <header class="fixed top-0 w-full max-w-md bg-background-light/90 backdrop-blur-md z-50 px-6 py-4 pt-12 flex justify-between items-center">
      <h1 class="text-xl font-bold text-neutral-900">Mi Perfil</h1>
      <button class="p-2 rounded-full hover:bg-neutral-200 transition-colors text-neutral-600">
        <span class="material-icons-round">settings</span>
      </button>
    </header>

    <main class="pt-24 px-4 space-y-6">
      <!-- Profile Card -->
      <div class="relative bg-gradient-to-br from-primary to-primary-dark rounded-2xl p-6 shadow-xl text-white overflow-hidden">
        <!-- Decorative circle -->
        <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>

        <div class="flex flex-col items-center relative z-10">
          <div class="relative mb-4">
            <div class="w-24 h-24 rounded-full border-4 border-white/30 p-1">
              <div class="w-full h-full rounded-full bg-primary-dark/50 flex items-center justify-center">
                <span class="material-icons-round text-white/80 text-4xl">person</span>
              </div>
            </div>
            <div class="absolute -bottom-2 inset-x-0 flex justify-center">
              <span class="bg-gold text-amber-900 text-xs font-bold px-3 py-1 rounded-full shadow-lg border-2 border-primary">
                NVL 12
              </span>
            </div>
          </div>

          <h2 class="text-2xl font-bold">Alex Walker</h2>
          <p class="text-white/80 text-sm mb-1">@alex_explorer</p>

          <div class="flex items-center gap-2 mt-2 bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full">
            <span class="material-icons-round text-sm">military_tech</span>
            <span class="text-xs font-semibold uppercase tracking-wider">Explorador Experto</span>
          </div>

          <!-- XP Bar -->
          <div class="w-full mt-6">
            <div class="flex justify-between text-xs font-medium text-white/90 mb-2">
              <span>Progreso XP</span>
              <span>2450 / 3000</span>
            </div>
            <div class="h-3 bg-black/20 rounded-full overflow-hidden backdrop-blur-sm">
              <div class="h-full bg-gold rounded-full" style="width: 82%;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 gap-4">
        <!-- WQ Balance -->
        <a href="/app/wallet" class="col-span-2 bg-white p-4 rounded-xl shadow-sm flex items-center justify-between border border-neutral-100 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <span class="material-icons-round">account_balance_wallet</span>
            </div>
            <div>
              <p class="text-xs text-neutral-500 font-medium">Balance Billetera</p>
              <p class="text-lg font-bold text-neutral-900">250 WQ <span class="text-sm font-normal text-neutral-500">(≈ $25.000 CLP)</span></p>
            </div>
          </div>
          <span class="text-primary text-sm font-semibold">Detalles</span>
        </a>

        <!-- Stats: Quests -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-neutral-100 text-center">
          <p class="text-3xl font-bold text-primary mb-1">47</p>
          <p class="text-xs text-neutral-500 font-medium uppercase tracking-wide">Quests</p>
        </div>

        <!-- Stats: Routes -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-neutral-100 text-center">
          <p class="text-3xl font-bold text-primary mb-1">12</p>
          <p class="text-xs text-neutral-500 font-medium uppercase tracking-wide">Rutas</p>
        </div>
      </div>

      <!-- Leaderboard Preview -->
      <section>
        <div class="flex justify-between items-end mb-4">
          <h3 class="text-lg font-bold text-neutral-900">Ranking Santiago</h3>
          <span class="text-primary text-sm font-semibold cursor-pointer hover:underline">Ver Todo</span>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-neutral-100 overflow-hidden">
          <!-- User's Rank -->
          <div class="bg-primary/5 p-4 flex items-center gap-4 border-b border-neutral-100">
            <span class="font-bold text-primary text-lg w-8">#34</span>
            <div class="w-10 h-10 rounded-full bg-primary/20 ring-2 ring-primary flex items-center justify-center">
              <span class="material-icons-round text-primary">person</span>
            </div>
            <div class="flex-1">
              <p class="font-bold text-sm text-neutral-900">Tu</p>
              <p class="text-xs text-neutral-500">2450 XP</p>
            </div>
            <span class="material-icons-round text-neutral-400">arrow_forward_ios</span>
          </div>

          <!-- Top Players Preview -->
          <div class="p-4 flex justify-between items-center">
            <div class="flex -space-x-3">
              <div class="w-10 h-10 rounded-full border-2 border-white bg-amber-100 flex items-center justify-center">
                <span class="text-amber-600 font-bold text-sm">1</span>
              </div>
              <div class="w-10 h-10 rounded-full border-2 border-white bg-neutral-200 flex items-center justify-center">
                <span class="text-neutral-600 font-bold text-sm">2</span>
              </div>
              <div class="w-10 h-10 rounded-full border-2 border-white bg-amber-50 flex items-center justify-center">
                <span class="text-amber-700 font-bold text-sm">3</span>
              </div>
            </div>
            <div class="text-right">
              <p class="text-xs text-neutral-500 font-medium">Top 3 Jugadores</p>
              <p class="text-xs text-primary font-bold">Liderando con 8.5k+ XP</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Achievements -->
      <section>
        <h3 class="text-lg font-bold text-neutral-900 mb-4">Logros</h3>
        <div class="grid grid-cols-3 gap-3">
          <!-- Unlocked 1 -->
          <div class="flex flex-col items-center p-3 bg-white rounded-xl shadow-sm border border-neutral-100">
            <div class="w-14 h-14 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mb-2 shadow-inner">
              <span class="material-icons-round text-3xl">flag</span>
            </div>
            <span class="text-xs font-bold text-center text-neutral-900 leading-tight">Primera Quest</span>
          </div>

          <!-- Unlocked 2 -->
          <div class="flex flex-col items-center p-3 bg-white rounded-xl shadow-sm border border-neutral-100">
            <div class="w-14 h-14 rounded-full bg-primary/20 text-primary flex items-center justify-center mb-2 shadow-inner">
              <span class="material-icons-round text-3xl">photo_camera</span>
            </div>
            <span class="text-xs font-bold text-center text-neutral-900 leading-tight">Fotografo</span>
          </div>

          <!-- Unlocked 3 -->
          <div class="flex flex-col items-center p-3 bg-white rounded-xl shadow-sm border border-neutral-100">
            <div class="w-14 h-14 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mb-2 shadow-inner">
              <span class="material-icons-round text-3xl">directions_walk</span>
            </div>
            <span class="text-xs font-bold text-center text-neutral-900 leading-tight">Madrugador</span>
          </div>

          <!-- Locked 1 -->
          <div class="flex flex-col items-center p-3 bg-neutral-50 rounded-xl border border-neutral-100 opacity-60">
            <div class="w-14 h-14 rounded-full bg-neutral-200 text-neutral-400 flex items-center justify-center mb-2">
              <span class="material-icons-round text-3xl">menu_book</span>
            </div>
            <span class="text-xs font-semibold text-center text-neutral-500 leading-tight">Historiador</span>
          </div>

          <!-- Locked 2 -->
          <div class="flex flex-col items-center p-3 bg-neutral-50 rounded-xl border border-neutral-100 opacity-60">
            <div class="w-14 h-14 rounded-full bg-neutral-200 text-neutral-400 flex items-center justify-center mb-2">
              <span class="material-icons-round text-3xl">nightlife</span>
            </div>
            <span class="text-xs font-semibold text-center text-neutral-500 leading-tight">Leyenda Urbana</span>
          </div>

          <!-- Locked 3 -->
          <div class="flex flex-col items-center p-3 bg-neutral-50 rounded-xl border border-neutral-100 opacity-60">
            <div class="w-14 h-14 rounded-full bg-neutral-200 text-neutral-400 flex items-center justify-center mb-2">
              <span class="material-icons-round text-3xl">diamond</span>
            </div>
            <span class="text-xs font-semibold text-center text-neutral-500 leading-tight">Cazatesoros</span>
          </div>
        </div>
      </section>

      <!-- Recent Activity -->
      <section>
        <h3 class="text-lg font-bold text-neutral-900 mb-4">Quests Recientes</h3>
        <div class="space-y-4">
          <!-- Activity Item 1 -->
          <div class="bg-white p-3 rounded-xl shadow-sm border border-neutral-100 flex gap-4">
            <div class="w-20 h-20 shrink-0 rounded-lg overflow-hidden relative bg-gradient-to-br from-amber-200 to-orange-300 flex items-center justify-center">
              <span class="material-icons-round text-white/80 text-3xl">account_balance</span>
            </div>
            <div class="flex-1 flex flex-col justify-center">
              <h4 class="font-bold text-neutral-900 text-sm">Centro Historico</h4>
              <p class="text-xs text-neutral-500 mt-1 line-clamp-2">Completaste los 5 puntos de control alrededor de la plaza antigua.</p>
              <div class="flex items-center gap-2 mt-2">
                <span class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded-full font-bold">+50 XP</span>
                <span class="text-[10px] text-neutral-400">hace 2h</span>
              </div>
            </div>
          </div>

          <!-- Activity Item 2 -->
          <div class="bg-white p-3 rounded-xl shadow-sm border border-neutral-100 flex gap-4">
            <div class="w-20 h-20 shrink-0 rounded-lg overflow-hidden relative bg-gradient-to-br from-primary/30 to-cyan-300 flex items-center justify-center">
              <span class="material-icons-round text-white/80 text-3xl">palette</span>
            </div>
            <div class="flex-1 flex flex-col justify-center">
              <h4 class="font-bold text-neutral-900 text-sm">Arte Callejero Rio</h4>
              <p class="text-xs text-neutral-500 mt-1 line-clamp-2">Capturaste 3 piezas de arte callejero junto al rio.</p>
              <div class="flex items-center gap-2 mt-2">
                <span class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded-full font-bold">+30 XP</span>
                <span class="text-[10px] text-neutral-400">hace 1d</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
</AppLayout>
