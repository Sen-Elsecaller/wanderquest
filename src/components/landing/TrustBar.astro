---
const stats = [
  {
    icon: 'users',
    value: '10,000+',
    label: 'exploradores activos',
  },
  {
    icon: 'map',
    value: '500+',
    label: 'quests disponibles',
  },
  {
    icon: 'store',
    value: '200+',
    label: 'comercios asociados',
  },
];

// SVG icons as components
const icons: Record<string, string> = {
  users: `<svg class="w-7 h-7 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>`,
  map: `<svg class="w-7 h-7 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
  </svg>`,
  store: `<svg class="w-7 h-7 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
  </svg>`,
};
---

<section class="w-full bg-off-white py-12 lg:py-16">
  <div class="w-full px-4 sm:px-6 lg:px-10 xl:px-16">
    <div class="reveal bg-navy rounded-[28px] p-8 lg:p-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        {stats.map((stat) => (
          <div class="flex items-center gap-4 md:justify-center">
            <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0">
              <Fragment set:html={icons[stat.icon]} />
            </div>
            <div>
              <p class="text-3xl lg:text-4xl font-heading font-bold text-white">
                {stat.value}
              </p>
              <p class="text-sm text-white/70">{stat.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
