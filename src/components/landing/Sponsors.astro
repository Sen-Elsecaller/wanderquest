---
// Ecosystem flow steps
const ecosystemSteps = [
  {
    icon: 'storefront',
    title: 'Comercio Sponsor',
    description: 'Financia quests para atraer clientes reales',
    color: 'bg-accent/10 text-accent',
  },
  {
    icon: 'savings',
    title: 'Pool Común',
    description: 'Respalda todos los tokens WQ emitidos',
    color: 'bg-primary/10 text-primary',
  },
  {
    icon: 'explore',
    title: 'Explorador',
    description: 'Completa quests y gana tokens WQ',
    color: 'bg-emerald-100 text-emerald-600',
  },
];

// Partner categories for redemption
const partners = [
  {
    icon: 'coffee',
    name: 'Cafeterías',
    example: 'Café con leche gratis',
    tokens: 50,
  },
  {
    icon: 'museum',
    name: 'Museos',
    example: 'Entrada 2x1',
    tokens: 80,
  },
  {
    icon: 'restaurant',
    name: 'Restaurantes',
    example: 'Postre de regalo',
    tokens: 60,
  },
  {
    icon: 'shop',
    name: 'Tiendas Locales',
    example: '15% descuento',
    tokens: 40,
  },
  {
    icon: 'bike',
    name: 'Arriendo Bikes',
    example: '30 min gratis',
    tokens: 35,
  },
  {
    icon: 'theater',
    name: 'Teatros',
    example: 'Asiento preferencial',
    tokens: 100,
  },
];

const icons: Record<string, string> = {
  coffee: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3m8.293 8.293l1.414 1.414" /></svg>`,
  museum: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" /></svg>`,
  restaurant: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.87c1.355 0 2.697.055 4.024.165C17.155 8.51 18 9.473 18 10.608v2.513m-3-4.87v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0L3 16.5m15-3.38a48.474 48.474 0 00-6-.37c-2.032 0-4.034.125-6 .37m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.17c0 .62-.504 1.124-1.125 1.124H4.125A1.125 1.125 0 013 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 016 13.12" /></svg>`,
  shop: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>`,
  bike: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  theater: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" /></svg>`,
};
---

<section class="w-full bg-navy py-16 lg:py-24 relative overflow-hidden">
  <!-- Top Gradient Fade (transition from previous section) -->
  <div class="absolute top-0 left-0 right-0 h-16 bg-gradient-to-b from-off-white to-transparent z-[5]"></div>

  <!-- Vanta FOG Background -->
  <div id="vanta-fog" class="absolute inset-0 z-0"></div>

  <div class="w-full px-4 sm:px-6 lg:px-10 xl:px-16 relative z-10">
    <!-- Header -->
    <div class="text-center mb-12 reveal">
      <h2 class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl" style="color: white;">
        El ecosistema WanderQuest
      </h2>
      <p class="text-base md:text-lg mt-4 max-w-2xl mx-auto" style="color: rgba(255,255,255,0.7);">
        Comercios financian, tú exploras, todos ganan.
      </p>
    </div>

    <!-- Ecosystem Flow Diagram -->
    <div class="max-w-4xl mx-auto mb-16">
      <div class="relative">
        <!-- Flow Steps -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-4">
          {ecosystemSteps.map((step, index) => (
            <div class={`reveal stagger-${index + 1}`}>
              <div class="relative bg-white rounded-2xl p-6 border-2 border-primary/30 shadow-lg text-center h-full">
                <!-- Step Number -->
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-7 h-7 rounded-full bg-primary text-white text-sm font-bold flex items-center justify-center shadow-md">
                  {index + 1}
                </div>

                <!-- Icon -->
                <div class={`w-16 h-16 rounded-2xl ${step.color} flex items-center justify-center mx-auto mb-4 mt-2`}>
                  <span class="material-icons-round text-3xl">{step.icon}</span>
                </div>

                <!-- Title -->
                <h3 class="font-heading font-bold text-navy text-lg mb-2">
                  {step.title}
                </h3>

                <!-- Description -->
                <p class="text-sm text-text-muted">
                  {step.description}
                </p>

                <!-- Arrow (hidden on last item and mobile) -->
                {index < ecosystemSteps.length - 1 && (
                  <div class="hidden md:block absolute top-1/2 -right-5 transform -translate-y-1/2 text-white/60 z-10">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Return Arrow (Canje) -->
        <div class="reveal mt-8 flex items-center justify-center gap-3">
          <div class="h-px w-16 bg-gradient-to-r from-transparent to-primary/50"></div>
          <div class="flex items-center gap-2 bg-primary/20 border border-primary/30 rounded-full px-4 py-2 backdrop-blur-sm">
            <span class="material-icons-round text-primary text-xl">redeem</span>
            <span class="text-sm font-medium text-white">El explorador canjea WQ en cualquier comercio aliado</span>
          </div>
          <div class="h-px w-16 bg-gradient-to-l from-transparent to-primary/50"></div>
        </div>
      </div>
    </div>

    <!-- Partners Carousel -->
    <div class="max-w-4xl mx-auto relative">
      <!-- Left Arrow -->
      <button
        id="carousel-prev"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 w-10 h-10 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 flex items-center justify-center text-white hover:bg-white hover:text-navy transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
        aria-label="Anterior"
      >
        <span class="material-icons-round text-xl">chevron_left</span>
      </button>

      <!-- Carousel Container -->
      <div id="partners-carousel" class="flex gap-4 overflow-x-auto pb-4 hide-scrollbar snap-x snap-mandatory scroll-smooth">
        {partners.map((partner, index) => (
          <div class={`reveal stagger-${index + 1} group flex-none w-[calc(25%-12px)] min-w-[200px] snap-start`}>
            <div class="bg-white rounded-2xl p-5 border border-gray-100 hover:border-primary/30 hover:shadow-lg transition-all duration-300 h-full flex flex-col items-center text-center">
              <!-- Icon -->
              <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                <Fragment set:html={icons[partner.icon]} />
              </div>

              <!-- Name -->
              <h3 class="font-heading font-bold text-text-heading text-sm mb-2">
                {partner.name}
              </h3>

              <!-- Example Reward -->
              <p class="text-xs text-text-muted mb-3">
                {partner.example}
              </p>

              <!-- Token Cost -->
              <div class="mt-auto flex items-center gap-1 text-xs font-medium text-accent">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.31-8.86c-1.77-.45-2.34-.94-2.34-1.67 0-.84.79-1.43 2.1-1.43 1.38 0 1.9.66 1.94 1.64h1.71c-.05-1.34-.87-2.57-2.49-2.97V5H10.9v1.69c-1.51.32-2.72 1.3-2.72 2.81 0 1.79 1.49 2.69 3.66 3.21 1.95.46 2.34 1.15 2.34 1.87 0 .53-.39 1.39-2.1 1.39-1.6 0-2.23-.72-2.32-1.64H8.04c.1 1.7 1.36 2.66 2.86 2.97V19h2.34v-1.67c1.52-.29 2.72-1.16 2.73-2.77-.01-2.2-1.9-2.96-3.66-3.42z" />
                </svg>
                <span>{partner.tokens} WQ</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Right Arrow -->
      <button
        id="carousel-next"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-10 w-10 h-10 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 flex items-center justify-center text-white hover:bg-white hover:text-navy transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
        aria-label="Siguiente"
      >
        <span class="material-icons-round text-xl">chevron_right</span>
      </button>

      <!-- Bottom Text -->
      <div class="text-center mt-8 reveal">
        <p class="text-lg font-heading font-semibold text-white mb-1">
          Canjea en cualquier comercio aliado
        </p>
        <p class="text-sm text-white/60">
          Tus tokens WQ funcionan en toda la red — más de 200 comercios te esperan.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.getElementById('partners-carousel');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    if (!carousel || !prevBtn || !nextBtn) return;

    const scrollAmount = 220; // Approximate card width + gap

    function updateButtons() {
      prevBtn.disabled = carousel.scrollLeft <= 0;
      nextBtn.disabled = carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth - 10;
    }

    prevBtn.addEventListener('click', () => {
      carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });

    carousel.addEventListener('scroll', updateButtons);
    updateButtons();
  });
</script>

<!-- Vanta FOG -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.fog.min.js"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof VANTA !== 'undefined') {
      VANTA.FOG({
        el: "#vanta-fog",
        mouseControls: false,
        touchControls: false,
        gyroControls: false,
        minHeight: 200.00,
        minWidth: 200.00,
        highlightColor: 0x0891b2,
        midtoneColor: 0x0b1e4a,
        lowlightColor: 0x050d1f,
        baseColor: 0x0b1e4a,
        blurFactor: 0.4,
        speed: 1.0,
        zoom: 1.0
      });
    }
  });
</script>
