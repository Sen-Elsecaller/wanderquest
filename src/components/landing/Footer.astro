---
const footerLinks = {
  explorar: [
    { label: 'Misiones', href: '#' },
    { label: 'Mapa', href: '#' },
    { label: 'Leaderboard', href: '#' },
    { label: 'Recompensas', href: '#' },
  ],
  negocios: [
    { label: 'Ser sponsor', href: '#' },
    { label: 'Precios', href: '#' },
    { label: 'Casos de éxito', href: '#' },
    { label: 'API', href: '#' },
  ],
  recursos: [
    { label: 'Blog', href: '#' },
    { label: 'Ayuda', href: '#' },
    { label: 'Comunidad', href: '#' },
    { label: 'Creadores', href: '#' },
  ],
  legal: [
    { label: 'Términos', href: '#' },
    { label: 'Privacidad', href: '#' },
    { label: 'Cookies', href: '#' },
  ],
