---

<footer class="w-full bg-off-white border-t border-gray-200">
  <div class="w-full px-4 sm:px-6 lg:px-10 xl:px-16 py-12 lg:py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 lg:gap-12">
      <!-- Logo & Description -->
      <div class="col-span-2">
        <a href="#" class="flex items-center gap-2 group mb-4">
          <img src="/wanderquest-logo.png" alt="WanderQuest" class="w-10 h-10 rounded-xl transition-transform group-hover:scale-105" />
          <span class="font-heading font-bold text-xl text-text-heading">
            WanderQuest
          </span>
        </a>
        <p class="text-sm text-text-muted mb-6 max-w-xs">
          Explora tu ciudad, completa misiones y gana recompensas reales
          en comercios locales.
        </p>

        <!-- Social Links -->
        <div class="flex items-center gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              aria-label={social.label}
              class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center text-text-muted hover:bg-primary hover:text-white transition-colors"
            >
              <Fragment set:html={socialIcons[social.icon]} />
            </a>
          ))}
        </div>
      </div>

      <!-- Links Columns -->
      <div>
        <h4 class="font-heading font-semibold text-text-heading mb-4">
          Explorar
        </h4>
        <ul class="space-y-3">
          {footerLinks.explorar.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-text-muted hover:text-primary transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-heading font-semibold text-text-heading mb-4">
          Para negocios
        </h4>
        <ul class="space-y-3">
          {footerLinks.negocios.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-text-muted hover:text-primary transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-heading font-semibold text-text-heading mb-4">
          Recursos
        </h4>
        <ul class="space-y-3">
          {footerLinks.recursos.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-text-muted hover:text-primary transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-heading font-semibold text-text-heading mb-4">
          Legal
        </h4>
        <ul class="space-y-3">
          {footerLinks.legal.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-text-muted hover:text-primary transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-gray-200 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-text-muted">
        © {currentYear} WanderQuest. Todos los derechos reservados.
      </p>

      <!-- Stellar Badge -->
      <div class="flex items-center gap-3 bg-white rounded-xl px-4 py-2 shadow-sm border border-gray-100">
        <span class="text-xs text-text-muted">Powered by</span>
        <div class="flex items-center gap-2">
          <img src="/stellar-logo-small.png" alt="Stellar" class="h-5 w-auto" />
          <span class="text-sm font-semibold text-navy">Stellar</span>
        </div>
      </div>
    </div>
  </div>
</footer>
