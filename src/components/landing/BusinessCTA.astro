---
// BusinessCTA - CTA para comercios con formulario de contacto
// Layout inverso al FinalCTA: formulario a la izquierda, texto a la derecha
---

<section id="comercios" class="w-full bg-off-white pt-16 lg:pt-24 pb-8 lg:pb-12">
  <div class="w-full px-4 sm:px-6 lg:px-10 xl:px-16">
    <div class="reveal relative overflow-hidden rounded-[28px] bg-gradient-to-br from-accent to-accent-dark p-8 lg:p-16">
      <!-- Background Decorations -->
      <div class="absolute top-0 left-0 w-96 h-96 bg-white/10 rounded-full -translate-y-1/2 -translate-x-1/2"></div>
      <div class="absolute bottom-0 right-0 w-64 h-64 bg-primary/20 rounded-full translate-y-1/2 translate-x-1/2"></div>

      <!-- Store Icon -->
      <svg class="absolute top-8 left-8 w-8 h-8 text-white/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>

      <div class="relative grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Left: Contact Form -->
        <div class="bg-white/10 backdrop-blur-sm rounded-[22px] p-6 lg:p-8 border border-white/20 order-2 lg:order-1">
          <h3 class="text-xl font-heading font-bold text-white mb-2">
            Contacta con nosotros
          </h3>
          <p class="text-sm text-white mb-6">
            Completa el formulario y te contactaremos en menos de 24 horas.
          </p>

          <form id="business-form" class="space-y-4">
            <!-- Nombre del negocio -->
            <div class="relative">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              <input
                type="text"
                id="business-name"
                placeholder="Nombre del negocio"
                class="w-full bg-white/10 border border-white/20 rounded-xl py-3 pl-12 pr-4 text-white placeholder:text-white/50 focus:outline-none focus:border-white/40 transition-colors"
                required
              />
            </div>

            <!-- Nombre de contacto -->
            <div class="relative">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <input
                type="text"
                id="contact-name"
                placeholder="Tu nombre"
                class="w-full bg-white/10 border border-white/20 rounded-xl py-3 pl-12 pr-4 text-white placeholder:text-white/50 focus:outline-none focus:border-white/40 transition-colors"
                required
              />
            </div>

            <!-- Email -->
            <div class="relative">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <input
                type="email"
                id="business-email"
                placeholder="email@negocio.com"
                class="w-full bg-white/10 border border-white/20 rounded-xl py-3 pl-12 pr-4 text-white placeholder:text-white/50 focus:outline-none focus:border-white/40 transition-colors"
                required
              />
            </div>

            <!-- Tipo de negocio (select) -->
            <div class="relative">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
              <select
                id="business-type"
                class="w-full bg-white/10 border border-white/20 rounded-xl py-3 pl-12 pr-4 text-white focus:outline-none focus:border-white/40 transition-colors appearance-none cursor-pointer"
                required
              >
                <option value="" disabled selected class="text-neutral-800">Tipo de negocio</option>
                <option value="cafeteria" class="text-neutral-800">Cafeteria / Restaurant</option>
                <option value="tienda" class="text-neutral-800">Tienda / Retail</option>
                <option value="museo" class="text-neutral-800">Museo / Cultura</option>
                <option value="turismo" class="text-neutral-800">Turismo / Tours</option>
                <option value="otro" class="text-neutral-800">Otro</option>
              </select>
              <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-4 h-4 text-white/50 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>

            <button
              type="submit"
              id="business-submit-btn"
              class="btn bg-white text-accent hover:bg-white/90 w-full"
            >
              <span id="business-btn-text">Quiero ser partner</span>
              <svg id="business-btn-arrow" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>

          <p class="text-xs text-white/50 mt-4 text-center">
            Sin compromiso. Te explicamos todo sin costo.
          </p>
        </div>

        <!-- Right: Text Content -->
        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full text-sm font-medium text-white mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            <span>Atrae clientes reales</span>
          </div>

          <h2 class="heading-2 text-white">
            Haz que te descubran explorando
          </h2>
          <p class="text-lg text-white/80 mt-4">
            Financia quests que lleven exploradores directamente a tu puerta.
            Solo pagas por visitas verificadas con prueba de ubicacion.
          </p>

          <!-- Benefits -->
          <ul class="mt-8 space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <span class="text-white font-semibold">Modelo CPVV</span>
                <p class="text-white/70 text-sm">Cost per Verified Visit. Paga solo cuando alguien realmente llega.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <span class="text-white font-semibold">Red de comercios aliados</span>
                <p class="text-white/70 text-sm">Tus tokens circulan en todo el ecosistema. Mas visibilidad, mas clientes.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <span class="text-white font-semibold">Dashboard en tiempo real</span>
                <p class="text-white/70 text-sm">Metricas claras: visitas, canjes, ROI. Todo transparente en blockchain.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('business-form');
  const submitBtn = document.getElementById('business-submit-btn');
  const btnText = document.getElementById('business-btn-text');
  const btnArrow = document.getElementById('business-btn-arrow');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // Show success state
    submitBtn?.classList.remove('bg-white', 'text-accent');
    submitBtn?.classList.add('bg-green-500', 'text-white');
    if (btnText) btnText.textContent = '¡Mensaje enviado!';
    btnArrow?.classList.add('hidden');

    // Reset after 3 seconds
    setTimeout(() => {
      submitBtn?.classList.add('bg-white', 'text-accent');
      submitBtn?.classList.remove('bg-green-500', 'text-white');
      if (btnText) btnText.textContent = 'Quiero ser partner';
      btnArrow?.classList.remove('hidden');
      form.reset();
    }, 3000);
  });
</script>
