---
const features = [
  {
    icon: 'map',
    title: 'Mapa interactivo',
    description: 'Marcadores de quests en tiempo real con dificultad y recompensas visibles.',
    accent: false,
  },
  {
    icon: 'book',
    title: 'Quests narrativas',
    description: 'Rutas con historia que revelan secretos y leyendas de tu ciudad.',
    accent: false,
  },
  {
    icon: 'clock',
    title: 'Quests efímeras',
    description: 'Misiones de tiempo limitado con recompensas extra. ¡No las dejes pasar!',
    accent: true,
  },
  {
    icon: 'refresh',
    title: 'Economía circular',
    description: 'Tokens ganados localmente, gastados localmente. Apoya a tu comunidad.',
    accent: false,
  },
  {
    icon: 'trophy',
    title: 'Niveles y logros',
    description: 'Sube de nivel, desbloquea insignias y accede a quests exclusivas.',
    accent: false,
  },
  {
    icon: 'plus',
    title: 'Crea tus quests',
    description: 'Diseña rutas y gana comisión cada vez que alguien complete tu misión.',
    accent: false,
  },
];

