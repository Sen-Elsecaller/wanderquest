  <div class="w-full px-4 sm:px-6 lg:px-10 xl:px-16">
    <!-- Journey Map Container - Full Width -->
    <div class="journey-container relative w-full">

      <!-- SVG Serpentine Path -->
      <svg
        class="journey-svg w-full h-auto"
        viewBox="0 0 1400 650"
        fill="none"
        preserveAspectRatio="xMidYMid meet"
      >
        <!--
          PATH DE REFERENCIA (invisible)
          ==============================
          Este path define la curva. No se muestra directamente.
          Lo usamos para calcular posiciones de los dashes.
        -->
        <path
          id="journey-path"
          d="M 80,120
             C 300,200 750,250 1050,280
             C 1250,380 400,450 350,480
             C 300,520 600,560 700,570
             C 800,580 1100,540 1320,580"
          stroke="none"
          fill="none"
        />

        <!--
          GRUPO DE DASHES
          ===============
          Los dashes se generan dinámicamente con JavaScript.
          Cada dash es un <rect> posicionado y rotado a lo largo del path.
        -->
        <g id="journey-dashes"></g>
      </svg>

      <!-- Checkpoints posicionados sobre la ruta -->
      <div class="checkpoints-container absolute inset-0">

        <!-- Checkpoint 1: HERO - Extremo izquierdo con brújula grande -->
        <div class="checkpoint checkpoint-1 checkpoint-hero absolute" style="top: 5%; left: 0;">
          <div class="checkpoint-hero-content" style="flex-direction: column; align-items: flex-start;">
            <AnimatedCompass size={160} class="compass-hero" />
            <div class="checkpoint-hero-card">
              <span class="checkpoint-number">01 — Comienza tu aventura</span>
              <h3 class="checkpoint-hero-title">{checkpoints[0].title}</h3>
              <p class="checkpoint-hero-desc">{checkpoints[0].description}</p>
            </div>
          </div>
        </div>

        <!-- Checkpoint 2: 3/4 derecha superior - TEXTO ARRIBA -->
        <div class="checkpoint checkpoint-2 absolute" style="top: 35%; left: 75%; transform: translateX(-50%);">
          <div class="checkpoint-marker">
            <div class="checkpoint-icon bg-accent text-white">
              <Fragment set:html={icons.footprints} />
            </div>
            <div class="checkpoint-pulse accent"></div>
          </div>
          <div class="checkpoint-card" style="left: 50%; top: auto; bottom: calc(100% + 16px); transform: translateX(-50%); text-align: center;">
            <span class="checkpoint-number">02</span>
            <h3 class="checkpoint-title">{checkpoints[1].title}</h3>
            <p class="checkpoint-desc">{checkpoints[1].description}</p>
          </div>
        </div>

        <!-- Checkpoint 3: Centro-izquierda medio - TEXTO A LA IZQUIERDA -->
        <div class="checkpoint checkpoint-3 absolute" style="top: 68%; left: 20%;">
          <div class="checkpoint-marker">
            <div class="checkpoint-icon bg-primary text-white">
              <Fragment set:html={icons.scan} />
            </div>
            <div class="checkpoint-pulse"></div>
          </div>
          <div class="checkpoint-card" style="left: auto; right: calc(100% + 16px); text-align: right;">
            <span class="checkpoint-number">03</span>
            <h3 class="checkpoint-title">{checkpoints[2].title}</h3>
            <p class="checkpoint-desc">{checkpoints[2].description}</p>
          </div>
        </div>

        <!-- Checkpoint 4: Centro - TEXTO MÁS ARRIBA -->
        <div class="checkpoint checkpoint-4 absolute" style="top: 78%; left: 50%; transform: translateX(-50%);">
          <div class="checkpoint-marker">
            <div class="checkpoint-icon bg-accent text-white">
              <Fragment set:html={icons.book} />
            </div>
            <div class="checkpoint-pulse accent"></div>
          </div>
          <div class="checkpoint-card" style="top: 30%; transform: translateY(-50%);">
            <span class="checkpoint-number">04</span>
            <h3 class="checkpoint-title">{checkpoints[3].title}</h3>
            <p class="checkpoint-desc">{checkpoints[3].description}</p>
          </div>
        </div>

        <!-- Checkpoint 5: HERO - Extremo derecho - TEXTO ARRIBA -->
        <div class="checkpoint checkpoint-5 checkpoint-hero checkpoint-hero-end absolute" style="top: 50%; right: 0;">
          <div class="checkpoint-hero-content" style="flex-direction: column; align-items: flex-end; text-align: right;">
            <div class="checkpoint-hero-card end" style="margin-bottom: 16px;">
              <span class="checkpoint-number">05 — Meta alcanzada</span>
              <h3 class="checkpoint-hero-title">{checkpoints[4].title}</h3>
              <p class="checkpoint-hero-desc">{checkpoints[4].description}</p>
            </div>
            <div class="checkpoint-end-icon">
              <div class="trophy-icon">
                <svg class="w-16 h-16 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-4.5A3.75 3.75 0 0112.75 10.5h-1.5A3.75 3.75 0 017.5 14.25v4.5m9-9V3.75m-9 6V3.75m0 0h9m-9 0H6m7.5 0v-.75A2.25 2.25 0 0111.25 .75h1.5a2.25 2.25 0 012.25 2.25v.75" />
                </svg>
                <div class="trophy-glow"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Floating Feature Cards -->
      <div class="floating-features absolute inset-0 pointer-events-none">

        <div class="feature-float feature-1 feature-expandable" style="top: 10%; left: 40%;">
          <div class="feature-tag-expandable primary">
            <span class="feature-tag-title">Mapa interactivo</span>
            <p class="feature-tag-desc">Explora tu ciudad en tiempo real. Descubre quests cercanas con filtros por categoría y dificultad.</p>
          </div>
        </div>

        <div class="feature-float feature-2 feature-expandable" style="top: 30%; right: 12%;">
          <span class="feature-badge">Nuevo</span>
          <div class="feature-tag-expandable accent">
            <span class="feature-tag-title">Quests efímeras</span>
            <p class="feature-tag-desc">Misiones que aparecen por tiempo limitado. Eventos especiales, clima único o momentos del día.</p>
          </div>
        </div>

        <div class="feature-float feature-3 feature-expandable" style="top: 15%; right: 0%;">
          <div class="feature-tag-expandable primary">
            <span class="feature-tag-title">Quests narrativas</span>
            <p class="feature-tag-desc">Historias conectadas que revelan la historia oculta de tu ciudad, paso a paso.</p>
          </div>
        </div>

        <div class="feature-float feature-4 feature-expandable" style="top: 40%; right: 40%;">
          <div class="feature-tag-expandable primary">
            <span class="feature-tag-title">Niveles y logros</span>
            <p class="feature-tag-desc">Sube de nivel explorando. Desbloquea insignias únicas y compite con otros aventureros.</p>
          </div>
        </div>

        <div class="feature-float feature-5 feature-expandable" style="top: 35%; left: 22%;">
          <div class="feature-tag-expandable accent">
            <span class="feature-tag-title">Economía circular</span>
            <p class="feature-tag-desc">Tus tokens vuelven a los comercios locales, fortaleciendo la economía del barrio.</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  /* Fondo sólido */
  .journey-section {
    background: var(--color-off-white);
  }

  /* Silueta de ciudad de fondo */
  .city-skyline {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    color: var(--color-primary);
    opacity: 0.08;
    pointer-events: none;
    z-index: 0;
  }

  .city-skyline svg {
    width: 100%;
    height: 100%;
  }

  .journey-container {
    min-height: 500px;
    position: relative;
  }

  .journey-svg {
    position: relative;
    z-index: 1;
  }

  /* Dashes del camino */
  .journey-dash {
    transform-origin: center center;
    transform-box: fill-box;
  }

  /* Checkpoints */
  .checkpoint {
    z-index: 10;
    opacity: 0;
    transform: scale(0.8);
  }

  /* Checkpoint Hero (primer checkpoint con brújula) */
  .checkpoint-hero {
    z-index: 20;
  }

  .checkpoint-hero-content {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .checkpoint-hero-card {
    background: white;
    border-radius: 20px;
    padding: 24px 28px;
    box-shadow: 0 12px 40px rgba(11, 30, 74, 0.12);
    border: 1px solid rgba(11, 30, 74, 0.06);
    max-width: 280px;
  }

  .checkpoint-hero-title {
    font-family: var(--font-family-heading);
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-top: 8px;
    line-height: 1.2;
  }

  .checkpoint-hero-desc {
    font-size: 15px;
    color: var(--color-text-muted);
    margin-top: 8px;
    line-height: 1.5;
  }

  .compass-hero {
    flex-shrink: 0;
  }

  /* Checkpoint Hero End (paso 5 - extremo derecho) */
  .checkpoint-hero-content.reverse {
    flex-direction: row-reverse;
  }

  .checkpoint-hero-card.end {
    text-align: right;
  }

  .checkpoint-end-icon {
    flex-shrink: 0;
  }

  .trophy-icon {
    position: relative;
    width: 140px;
    height: 140px;
    background: linear-gradient(135deg, var(--color-accent), #FBBF24);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 40px rgba(249, 115, 22, 0.35);
  }

  .trophy-icon svg {
    color: white;
    width: 64px;
    height: 64px;
  }

  .trophy-glow {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent), #FBBF24);
    opacity: 0;
    z-index: -1;
    animation: trophy-pulse 2.5s ease-in-out infinite;
  }

  @keyframes trophy-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0;
    }
    50% {
      transform: scale(1.15);
      opacity: 0.3;
    }
  }

  .checkpoint-marker {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .checkpoint-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(8, 145, 178, 0.3);
    position: relative;
    z-index: 2;
  }

  .checkpoint-icon.bg-accent {
    box-shadow: 0 8px 24px rgba(249, 115, 22, 0.3);
  }

  .checkpoint-pulse {
    position: absolute;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--color-primary);
    opacity: 0;
    z-index: 1;
  }

  .checkpoint-pulse.accent {
    background: var(--color-accent);
  }

  .checkpoint.active .checkpoint-pulse {
    animation: pulse-ring 2s ease-out infinite;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(1);
      opacity: 0.4;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .checkpoint-card {
    position: absolute;
    left: calc(100% + 16px);
    top: 50%;
    transform: translateY(-50%);
    background: white;
    border-radius: 16px;
    padding: 16px 20px;
    box-shadow: 0 8px 32px rgba(11, 30, 74, 0.1);
    border: 1px solid rgba(11, 30, 74, 0.06);
    min-width: 200px;
    white-space: nowrap;
  }

  .checkpoint-card.right {
    left: auto;
    right: calc(100% + 16px);
  }

  .checkpoint-number {
    font-family: var(--font-family-heading);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .checkpoint-title {
    font-family: var(--font-family-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-top: 4px;
  }

  .checkpoint-desc {
    font-size: 14px;
    color: var(--color-text-muted);
    margin-top: 4px;
    white-space: normal;
    max-width: 180px;
  }

  /* Floating Features */
  .feature-float {
    position: absolute;
    z-index: 5;
    opacity: 0;
    transform: translateY(20px);
    pointer-events: auto;
  }

  .feature-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    background: white;
    box-shadow: 0 4px 20px rgba(11, 30, 74, 0.1);
    border: 1px solid rgba(11, 30, 74, 0.06);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .feature-tag.primary {
    color: var(--color-primary);
  }

  .feature-tag.primary:hover {
    background: var(--color-primary);
    color: white;
    transform: scale(1.05);
  }

  .feature-tag.accent {
    color: var(--color-accent);
  }

  .feature-tag.accent:hover {
    background: var(--color-accent);
    color: white;
    transform: scale(1.05);
  }

  .feature-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--color-accent);
    color: white;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Feature Tag Expandible */
  .feature-tag-expandable {
    display: flex;
    flex-direction: column;
    padding: 12px 18px;
    border-radius: 16px;
    background: white;
    box-shadow: 0 4px 20px rgba(11, 30, 74, 0.1);
    border: 1px solid rgba(11, 30, 74, 0.06);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    max-width: 180px;
    overflow: hidden;
  }

  .feature-tag-expandable.accent {
    color: var(--color-accent);
  }

  .feature-tag-expandable.primary {
    color: var(--color-primary);
  }

  .feature-tag-title {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  .feature-tag-desc {
    font-size: 12px;
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin-top: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: normal;
  }

  /* Estado expandido */
  .feature-tag-expandable.expanded {
    max-width: 240px;
    box-shadow: 0 8px 30px rgba(11, 30, 74, 0.15);
  }

  .feature-tag-expandable.expanded .feature-tag-desc {
    max-height: 100px;
    opacity: 1;
    margin-top: 8px;
  }

  .feature-tag-expandable.accent:hover,
  .feature-tag-expandable.accent.expanded {
    border-color: var(--color-accent);
  }

  .feature-tag-expandable.primary:hover,
  .feature-tag-expandable.primary.expanded {
    border-color: var(--color-primary);
  }

  .feature-float:hover .feature-badge {
    animation: bounce 0.5s ease;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  /* Responsive */
  @media (max-width: 1280px) {
    .journey-container {
      min-height: 800px;
    }

    .checkpoint-hero-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .checkpoint-hero-content.reverse {
      align-items: flex-end;
    }

    .checkpoint-hero-card {
      max-width: 100%;
    }

    .checkpoint-hero-card.end {
      text-align: left;
    }

    .trophy-icon {
      width: 100px;
      height: 100px;
    }

    .trophy-icon svg {
      width: 48px;
      height: 48px;
    }
  }

  @media (max-width: 1024px) {
    .journey-container {
      min-height: 700px;
    }

    .checkpoint-card {
      position: relative;
      left: 0;
      top: 8px;
      transform: none;
      min-width: auto;
    }

    .checkpoint-card.right {
      right: 0;
    }

    .feature-float {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .journey-container {
      min-height: auto;
    }

    .journey-svg {
      display: none;
    }

    .checkpoints-container {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .checkpoint {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      transform: none !important;
      opacity: 1 !important;
    }

    .checkpoint-hero-content,
    .checkpoint-hero-content.reverse {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
    }

    .checkpoint-hero-card,
    .checkpoint-hero-card.end {
      padding: 20px;
      text-align: center;
    }

    .checkpoint-hero-title {
      font-size: 20px;
    }

    .trophy-icon {
      width: 120px;
      height: 120px;
    }

    .trophy-icon svg {
      width: 56px;
      height: 56px;
    }

    .checkpoint:not(.checkpoint-hero) {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }

    .checkpoint-card {
      box-shadow: none;
      border: none;
      padding: 0;
      background: transparent;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // Solo ejecutar en pantallas grandes
    if (window.innerWidth < 768) return;

    // =========================================
    // CONFIGURACIÓN
    // =========================================
    const CONFIG = {
      // Dashes
      numDashes: 90,           // Cantidad de dashes en el camino
      dashWidth: 24,           // Largo del dash (px en el SVG)
      dashHeight: 5,           // Grosor del dash
      dashGap: 0.012,          // Espacio entre dashes (0-1, porcentaje del path)

      // Scroll
      scrollDuration: '+=200%', // Cuánto scroll para completar (más = más lento)
      scrubSmoothing: 1.5,      // Suavizado del scroll

      // Checkpoints (posición en el path, 0-1)
      checkpointPositions: [0, 0.32, 0.6, 0.68, 0.95],
    };

    // =========================================
    // ELEMENTOS
    // =========================================
    const journeyPath = document.getElementById('journey-path') as SVGPathElement | null;
    const dashesGroup = document.getElementById('journey-dashes');
    const checkpoints = document.querySelectorAll('.checkpoint');
    const floatingFeatures = document.querySelectorAll('.feature-float');

    if (!journeyPath || !dashesGroup) return;

    const pathLength = journeyPath.getTotalLength();

    // =========================================
    // PASO 1: GENERAR DASHES
    // =========================================
    // Calculamos puntos a lo largo del path y creamos un <rect> para cada dash

    const dashes: SVGRectElement[] = [];

    for (let i = 0; i < CONFIG.numDashes; i++) {
      // Posición en el path (0 a 1)
      const progress = i / (CONFIG.numDashes - 1);
      const distance = progress * pathLength;

      // Obtener punto y ángulo en esa posición
      const point = journeyPath.getPointAtLength(distance);

      // Calcular ángulo de rotación (usando el punto siguiente para dirección)
      const nextDistance = Math.min(distance + 1, pathLength);
      const nextPoint = journeyPath.getPointAtLength(nextDistance);
      const angle = Math.atan2(nextPoint.y - point.y, nextPoint.x - point.x) * (180 / Math.PI);

      // Crear el dash (rectángulo)
      const dash = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      dash.setAttribute('width', String(CONFIG.dashWidth));
      dash.setAttribute('height', String(CONFIG.dashHeight));
      dash.setAttribute('x', String(-CONFIG.dashWidth / 2)); // Centrar en origen
      dash.setAttribute('y', String(-CONFIG.dashHeight / 2));
      dash.setAttribute('rx', '2'); // Bordes redondeados
      dash.setAttribute('fill', i % 3 === 0 ? 'var(--color-accent)' : 'var(--color-primary)');
      dash.setAttribute('transform', `translate(${point.x}, ${point.y}) rotate(${angle})`);
      dash.classList.add('journey-dash');

      // Estado inicial: invisible y pequeño
      gsap.set(dash, { opacity: 0, scale: 0 });

      dashesGroup.appendChild(dash);
      dashes.push(dash);
    }

    // =========================================
    // PASO 2: CONFIGURAR SCROLL + PINNING
    // =========================================

    const mainTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: '.journey-section',
        start: 'top top',
        end: CONFIG.scrollDuration,
        pin: true,
        pinSpacing: true,
        scrub: CONFIG.scrubSmoothing,
        // Callback para detectar progreso (usado para checkpoints)
        onUpdate: (self) => {
          checkCheckpoints(self.progress);
        },
      },
    });

    // =========================================
    // PASO 3: ANIMAR DASHES SECUENCIALMENTE
    // =========================================
    // Cada dash aparece uno después del otro

    dashes.forEach((dash, index) => {
      // Posición en el timeline (0 a 0.85 para dejar espacio al final)
      const startPosition = (index / dashes.length) * 0.85;

      mainTimeline.to(dash, {
        opacity: 1,
        scale: 1,
        duration: 0.1,
        ease: 'back.out(2)',
      }, startPosition);
    });

    // Pausa al final - el scroll se "estanca" un momento antes de continuar
    mainTimeline.to({}, { duration: 0.15 }, 0.85);

    // =========================================
    // PASO 4: DETECCIÓN DE CHECKPOINTS
    // =========================================

    const checkpointStates = new Array(checkpoints.length).fill(false);

    function checkCheckpoints(progress: number) {
      CONFIG.checkpointPositions.forEach((pos, index) => {
        // Si el progreso llegó a este checkpoint y no estaba activo
        if (progress >= pos && !checkpointStates[index]) {
          checkpointStates[index] = true;
          activateCheckpoint(index);
        }
        // Si retrocedió y el checkpoint estaba activo
        if (progress < pos && checkpointStates[index]) {
          checkpointStates[index] = false;
          deactivateCheckpoint(index);
        }
      });
    }

    function activateCheckpoint(index: number) {
      const checkpoint = checkpoints[index];
      if (!checkpoint) return;

      checkpoint.classList.add('active');

      // Animar el icono
      const icon = checkpoint.querySelector('.checkpoint-icon, .trophy-icon');
      if (icon) {
        gsap.to(icon, {
          scale: 1,
          opacity: 1,
          duration: 0.4,
          ease: 'back.out(1.7)',
        });
      }

      // Animar el texto (card) - aparece con fade + slide
      const card = checkpoint.querySelector('.checkpoint-card, .checkpoint-hero-card');
      if (card) {
        gsap.to(card, {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.5,
          delay: 0.2,
          ease: 'back.out(1.5)',
        });
      }

      console.log(`Checkpoint ${index + 1} activado`);
    }

    function deactivateCheckpoint(index: number) {
      const checkpoint = checkpoints[index];
      if (!checkpoint) return;

      checkpoint.classList.remove('active');

      // Ocultar el icono parcialmente
      const icon = checkpoint.querySelector('.checkpoint-icon, .trophy-icon');
      if (icon) {
        gsap.to(icon, {
          scale: 0.85,
          opacity: 0.5,
          duration: 0.3,
          ease: 'power2.in',
        });
      }

      // Ocultar el texto
      const card = checkpoint.querySelector('.checkpoint-card, .checkpoint-hero-card');
      if (card) {
        gsap.to(card, {
          opacity: 0,
          y: 15,
          scale: 0.9,
          duration: 0.3,
          ease: 'power2.in',
        });
      }
    }

    // =========================================
    // PASO 5: FLOATING FEATURES
    // =========================================

    floatingFeatures.forEach((feature, index) => {
      // Aparecen al inicio
      gsap.to(feature, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        delay: 0.5 + index * 0.1,
        ease: 'power2.out',
      });

      // Efecto flotante continuo
      gsap.to(feature, {
        y: '+=10',
        duration: 2 + index * 0.3,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
        delay: index * 0.2,
      });
    });

    // =========================================
    // PASO 6: FEATURE TAGS EXPANDIBLES
    // =========================================

    const expandableTags = document.querySelectorAll('.feature-tag-expandable');

    expandableTags.forEach((tag) => {
      tag.addEventListener('click', (e) => {
        e.stopPropagation();

        // Si ya está expandido, lo colapsamos
        if (tag.classList.contains('expanded')) {
          tag.classList.remove('expanded');
        } else {
          // Cerrar otros que estén abiertos
          expandableTags.forEach(t => t.classList.remove('expanded'));
          // Expandir este
          tag.classList.add('expanded');
        }
      });
    });

    // Cerrar al hacer click fuera
    document.addEventListener('click', () => {
      expandableTags.forEach(t => t.classList.remove('expanded'));
    });

    // =========================================
    // INICIALIZACIÓN
    // =========================================

    // Configurar estado inicial de cada checkpoint
    checkpoints.forEach((checkpoint, index) => {
      // Iconos empiezan semi-visibles
      const icon = checkpoint.querySelector('.checkpoint-icon, .trophy-icon');
      if (icon) {
        gsap.set(icon, { scale: 0.85, opacity: 0.5 });
      }

      // Textos empiezan ocultos
      const card = checkpoint.querySelector('.checkpoint-card, .checkpoint-hero-card');
      if (card) {
        gsap.set(card, { opacity: 0, y: 15, scale: 0.9 });
      }

      // El contenedor del checkpoint está visible
      gsap.set(checkpoint, { opacity: 1, scale: 1 });
    });

    // El primer checkpoint empieza activo
    checkpointStates[0] = true;
    const firstCheckpoint = checkpoints[0];
    if (firstCheckpoint) {
      firstCheckpoint.classList.add('active');
      const firstIcon = firstCheckpoint.querySelector('.checkpoint-icon, .trophy-icon');
      const firstCard = firstCheckpoint.querySelector('.checkpoint-card, .checkpoint-hero-card');
      if (firstIcon) gsap.set(firstIcon, { scale: 1, opacity: 1 });
      if (firstCard) gsap.set(firstCard, { opacity: 1, y: 0, scale: 1 });
    }
  });
</script>
