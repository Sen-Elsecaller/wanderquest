---
// JourneyMap - Ruta serpentina interactiva que muestra el flujo de usuario
// Combina "How it Works" + "Features" en una experiencia visual única

import AnimatedCompass from '../ui/AnimatedCompass.astro';

const checkpoints = [
  {
    id: 1,
    title: 'Encuentra quests',
    description: 'Abre el mapa y descubre misiones cercanas',
    icon: 'compass',
  },
  {
    id: 2,
    title: 'Explora el lugar',
    description: 'Camina hasta la ubicación y vive la aventura',
    icon: 'footprints',
  },
  {
    id: 3,
    title: 'Verifica tu visita',
    description: 'Escanea el QR como prueba de ubicación',
    icon: 'scan',
  },
  {
    id: 4,
    title: 'Descubre la historia',
    description: 'Conoce datos curiosos y leyendas del lugar',
    icon: 'book',
  },
  {
    id: 5,
    title: 'Gana recompensas',
    description: 'Recibe tokens WQ y canjéalos en cualquier comercio aliado — o retíralos como dinero real',
    icon: 'coins',
  },
];

const floatingFeatures = [
  { label: 'Mapa interactivo', position: 'left-1', color: 'primary' },
  { label: 'Quests efímeras', position: 'right-1', color: 'accent', badge: 'Nuevo' },
  { label: 'Quests narrativas', position: 'left-2', color: 'primary' },
  { label: 'Niveles y logros', position: 'right-2', color: 'primary' },
  { label: 'Economía circular', position: 'left-3', color: 'accent' },
];

const icons: Record<string, string> = {
  compass: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="10" />
    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor" />
  </svg>`,
  footprints: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
  </svg>`,
  scan: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
  </svg>`,
  book: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
  </svg>`,
  coins: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>`,
};
---

