---
const explorers = [
  'Descubre lugares ocultos en tu ciudad',
  'Gana recompensas mientras caminas',
  'Compite con amigos en el leaderboard',
  'Desbloquea misiones exclusivas',
];

const businesses = [
  'Tráfico peatonal medible y verificado',
  'Marketing basado en resultados reales',
  'Métricas de movilidad en tiempo real',
  'Conexión directa con exploradores locales',
];

const checkIcon = `<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>`;
---

<section id="para-negocios" class="w-full bg-off-white pt-8 pb-16 lg:pt-12 lg:pb-24">
  <div class="w-full px-4 sm:px-6 lg:px-10 xl:px-16">
    <!-- Section Header -->
    <div class="text-center mb-12 lg:mb-16 reveal">
      <h2 class="heading-2 text-text-heading">
        Dos mundos, un mismo objetivo
      </h2>
      <p class="body-text text-text-muted mt-4 max-w-2xl mx-auto">
        WanderQuest conecta a exploradores curiosos con negocios locales
        que buscan clientes reales.
      </p>
    </div>

    <!-- Two Columns -->
    <div class="grid lg:grid-cols-2 gap-6 lg:gap-8">
      <!-- Explorers Column -->
      <div class="reveal card p-8 lg:p-10 relative overflow-hidden">
        <!-- Background Accent -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>

        <div class="relative">
          <!-- Header -->
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-primary flex items-center justify-center">
              <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-heading font-bold text-text-heading">
                Para Exploradores
              </h3>
              <p class="text-sm text-text-muted">Descubre y gana</p>
            </div>
          </div>

          <!-- Features List -->
          <ul class="space-y-4">
            {explorers.map((item) => (
              <li class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0 mt-0.5 text-primary">
                  <Fragment set:html={checkIcon} />
                </div>
                <span class="text-text-body">{item}</span>
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <a href="#cta" class="btn btn-primary w-full mt-8">
            Quiero explorar
          </a>
        </div>
      </div>

      <!-- Businesses Column -->
      <div class="reveal card p-8 lg:p-10 relative overflow-hidden">
        <!-- Background Accent -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-accent/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>

        <div class="relative">
          <!-- Header -->
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-accent flex items-center justify-center">
              <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-heading font-bold text-text-heading">
                Para Negocios
              </h3>
              <p class="text-sm text-text-muted">Convierte tráfico en clientes</p>
            </div>
          </div>

          <!-- Features List -->
          <ul class="space-y-4">
            {businesses.map((item) => (
              <li class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-accent/20 flex items-center justify-center flex-shrink-0 mt-0.5 text-accent">
                  <Fragment set:html={checkIcon} />
                </div>
                <span class="text-text-body">{item}</span>
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <a href="#cta" class="btn btn-accent w-full mt-8">
            Quiero ser partner
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
